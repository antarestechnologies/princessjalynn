# Copy to .env.local for local development. Never commit real values.
# Every variable here is validated at boot by src/env.ts.

# --- Core ---
NODE_ENV=development
# Public origin of the site, no trailing slash. Used for absolute links in email and callbacks.
APP_URL=http://localhost:3000

# --- Database (Neon Postgres in production; any Postgres 16 locally) ---
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/princessjalynn

# --- Logging ---
# one of: fatal error warn info debug trace
LOG_LEVEL=info

# --- Phase 3: media ---
# fake = store files under MEDIA_LOCAL_DIR and serve them through our own signed route (dev only).
# bunny = Bunny Stream for video, Bunny Storage + CDN for images. Production refuses fake.
MEDIA_PROVIDER=fake
MEDIA_LOCAL_DIR=.data/media
# Bunny Stream library (video): Stream > Library > API
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=            # e.g. vz-abc123.b-cdn.net
BUNNY_STREAM_TOKEN_KEY=           # Library > Security > "Embed view token authentication" key (enable it)
# Bunny Storage zone + pull zone (images, thumbnails, blurred previews)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=           # Storage zone > FTP & API Access > Password
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_HOST=                   # pull zone hostname, e.g. media-abc.b-cdn.net
BUNNY_CDN_TOKEN_KEY=              # Pull zone > Security > Token authentication key (enable it)

# --- Placeholders for later phases (leave empty until that phase) ---
# Phase 4: payments
# PAYMENT_PROCESSOR=fake     # fake | ccbill | segpay | ...

# --- Phase 2: auth, age gate, email, age verification ---
# 32+ random chars. Keys sessions, the age-gate cookie and signed links. Required in production.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
# console prints verification/reset links to the server log (dev only). sendgrid sends real mail.
EMAIL_PROVIDER=console
SENDGRID_API_KEY=
EMAIL_FROM="Members <no-reply@example.com>"
# stub = anyone who clicks "pass" is verified. Replaced by the real vendor adapter when chosen.
AGE_VERIFIER=stub
# Never set this in production. It exists only so a staging deploy can exercise the flow.
ALLOW_STUB_AGE_VERIFIER=false
