# Copy to .env.local for local development. Never commit real values.
# Every variable here is validated at boot by src/env.ts.

# --- Core ---
NODE_ENV=development
# Public origin of the site, no trailing slash. Used for absolute links in email and callbacks.
APP_URL=http://localhost:3000

# --- Database (Neon Postgres in production; any Postgres 16 locally) ---
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/princessjalynn

# --- Logging ---
# one of: fatal error warn info debug trace
LOG_LEVEL=info

# --- Placeholders for later phases (leave empty until that phase) ---
# Phase 2: auth
# SESSION_SECRET=            # 32+ random bytes, base64. `openssl rand -base64 32`
# Phase 3: video (Bunny Stream)
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_TOKEN_AUTH_KEY=
# Phase 4: payments
# PAYMENT_PROCESSOR=fake     # fake | ccbill | segpay | ...
# Email (SendGrid)
# SENDGRID_API_KEY=
# EMAIL_FROM=
